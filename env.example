# Zahra Health Point — Environment Variables (template)
#
# Copy to `.env.local` (Next.js) and fill in the values below.
# NEVER commit real credentials to source control.

# -------------------------
# Supabase (PostgreSQL + Auth)
# -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# -------------------------
# Google Maps
# -------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<your-api-key>
GOOGLE_MAPS_EMBED_API_KEY=<embed-api-key>

# -------------------------
# WhatsApp (optional)
# -------------------------
WHATSAPP_BUSINESS_PHONE=<your-whatsapp-number>

# -------------------------
# Site config (hosted values)
# -------------------------
SITE_NAME=Zahra Health Point
TIMEZONE=Asia/Dhaka

# -------------------------
# Admin auth credentials (dev only — override in production)
# -------------------------
ADMIN_EMAIL=admin@zahrahealthpoint.com
ADMIN_PASSWORD_HASH=<bcrypt-hash-of-your-choice>

